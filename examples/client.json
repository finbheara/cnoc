{
  "server": "http://controller.example:7878",
  "name": "workbox",
  "projects": { "myapp": "~/github/myapp" },
  "resources": { "slots": 3, "gpu": 1 },
  "features": ["zfs"],
  "max_load": 0.9,
  "update": "git -C ~/.local/share/cnoc/app pull -q --ff-only && bun install --cwd ~/.local/share/cnoc/app --frozen-lockfile --production"
}
