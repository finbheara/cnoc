{
  "name": "cnoc",
  "version": "0.1.0",
  "description": "Batch scheduling of agent harness sessions across persistent hosts",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "bin": {
    "cnoc": "src/cli.ts"
  },
  "scripts": {
    "am-i-done": "bun install --frozen-lockfile --silent && am-i-done",
    "doing-it-wrong": "doing-it-wrong",
    "typecheck": "bun check",
    "lint": "bunx biome check --write .",
    "lint:check": "bunx biome check .",
    "test": "bun test",
    "prepare": "git config core.hooksPath .git-hooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "am-i-done": "^0.4.2"
  }
}
